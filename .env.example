# ==================================================================
# MaintCore — Variables de Entorno
# ==================================================================
# Copiar a .env y ajustar valores.
# Nunca commitear .env real.
# ==================================================================

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_USER=maintcore
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=maintcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------------
# Aplicaci\u00f3n
# ------------------------------------------------------------------
APP_NAME=MaintCore CMMS
APP_VERSION=0.1.0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Admin inicial (seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@maintcore.local
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
ADMIN_FULL_NAME=Administrator

